{
    "require-dev": {
        "php": ">=8.2",
        "ergebnis/composer-normalize": "^2.50",
        "guanguans/monorepo-builder-worker": "^3.1",
        "guzzlehttp/guzzle": "^7.10",
        "laravel/framework": "^12.55 || ^13.0",
        "mrpunyapal/rector-pest": "^0.2",
        "peckphp/peck": "^0.2",
        "phpbench/phpbench": "^1.5",
        "phpro/grumphp-shim": "^2.19"
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpro/grumphp-shim": false,
            "theofidry/composer-inheritance-plugin": false,
            "wikimedia/composer-merge-plugin": false
        },
        "sort-packages": true
    }
}
